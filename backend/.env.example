# Copy to backend/.env

# Local dev: turn dev mode on (enables /docs, SQL echo, verbose errors).
# Leave these OUT (or set to production/false) for a real deployment.
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://storyteller:storyteller@localhost:5432/storyteller

# Exact origins allowed to call the API from a browser (Flutter web / tooling).
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# --- auth (Fase 1 stap 4) ---
SUPABASE_URL=https://your-ref.supabase.co
# Only needed if your project still signs JWTs with the legacy HS256 secret;
# asymmetric (ES256) projects verify via SUPABASE_URL's JWKS and can leave this blank.
SUPABASE_JWT_SECRET=

# --- story generation + moderation (Fase 2) ---
ANTHROPIC_API_KEY=
# STORY_MODEL=claude-haiku-4-5
# MODERATION_MODEL=claude-haiku-4-5
# STORY_REGENERATION_ATTEMPTS=1

# --- abuse limits (per user, per hour) ---
# GENERATION_RATE_LIMIT_PER_HOUR=20
# AUDIO_RATE_LIMIT_PER_HOUR=40

# --- TTS (Fase 3) ---
# TTS_PROVIDER=piper            # piper | elevenlabs | disabled
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
